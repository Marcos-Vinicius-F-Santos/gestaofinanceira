rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() && userProfile().role == 'admin';
    }

    function isActiveClient() {
      return signedIn()
        && userProfile().role == 'client'
        && userProfile().status == 'active';
    }

    function isOwnUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isActiveOwnUser(userId) {
      return isOwnUser(userId) && userProfile().status == 'active';
    }

    function keepsUserIdentity() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
    }

    function updatesLoginMetadataOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'updatedAt'])
        && keepsUserIdentity();
    }

    function updatesPasswordMetadataOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'passwordChangedAt', 'firstLoginAt', 'updatedAt'])
        && request.resource.data.mustChangePassword == false
        && keepsUserIdentity();
    }

    function ownsExistingResource() {
      return isActiveClient() && resource.data.userId == request.auth.uid;
    }

    function ownsNewResource() {
      return isActiveClient() && request.resource.data.userId == request.auth.uid;
    }

    function keepsOwner() {
      return request.resource.data.userId == resource.data.userId;
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwnUser(userId);
      allow create: if isAdmin()
        && request.resource.data.uid == userId
        && request.resource.data.role in ['admin', 'client']
        && request.resource.data.status in ['pending', 'active', 'blocked'];
      allow update: if (
        isAdmin()
        && request.resource.data.role in ['admin', 'client']
        && request.resource.data.status in ['pending', 'active', 'blocked']
      ) || (isActiveOwnUser(userId) && (updatesLoginMetadataOnly() || updatesPasswordMetadataOnly()));
      allow delete: if isAdmin();
    }

    match /passwordResetCodes/{documentId} {
      allow read, write: if false;
    }

    match /produtos/{documentId} {
      allow read: if isAdmin() || ownsExistingResource();
      allow create: if isAdmin() || ownsNewResource();
      allow update: if isAdmin() || (ownsExistingResource() && ownsNewResource() && keepsOwner());
      allow delete: if isAdmin() || ownsExistingResource();
    }

    match /fornecedores/{documentId} {
      allow read: if isAdmin() || ownsExistingResource();
      allow create: if isAdmin() || ownsNewResource();
      allow update: if isAdmin() || (ownsExistingResource() && ownsNewResource() && keepsOwner());
      allow delete: if isAdmin() || ownsExistingResource();
    }

    match /contas/{documentId} {
      allow read: if isAdmin() || ownsExistingResource();
      allow create: if isAdmin() || ownsNewResource();
      allow update: if isAdmin() || (ownsExistingResource() && ownsNewResource() && keepsOwner());
      allow delete: if isAdmin() || ownsExistingResource();
    }

    match /subcontas/{documentId} {
      allow read: if isAdmin() || ownsExistingResource();
      allow create: if isAdmin() || ownsNewResource();
      allow update: if isAdmin() || (ownsExistingResource() && ownsNewResource() && keepsOwner());
      allow delete: if isAdmin() || ownsExistingResource();
    }

    match /movimentacoes/{documentId} {
      allow read: if isAdmin() || ownsExistingResource();
      allow create: if isAdmin() || ownsNewResource();
      allow update: if isAdmin() || (ownsExistingResource() && ownsNewResource() && keepsOwner());
      allow delete: if isAdmin() || ownsExistingResource();
    }

    match /parcelas/{documentId} {
      allow read: if isAdmin() || ownsExistingResource();
      allow create: if isAdmin() || ownsNewResource();
      allow update: if isAdmin() || (ownsExistingResource() && ownsNewResource() && keepsOwner());
      allow delete: if isAdmin() || ownsExistingResource();
    }
  }
}
